{
  "name": "text-splitter",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:supabase": "node scripts/dev-with-supabase.mjs",
    "ragas:setup": "node scripts/setup-ragas-worker.mjs",
    "ragas:test": "services/ragas-worker/.venv/bin/python -m pytest services/ragas-worker/tests",
    "check:design": "node scripts/check-design-system.mjs",
    "test:unit": "tsx --test tests/*.test.ts tests/*.test.tsx",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit --noUnusedLocals --noUnusedParameters",
    "verify": "npm run check:design && npm run lint && npm run typecheck && npm run test:unit && npm run build"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "dependencies": {
    "@langchain/core": "^1.2.4",
    "@langchain/openai": "^1.5.5",
    "@langchain/textsplitters": "^1.0.1",
    "@supabase/supabase-js": "^2.76.1",
    "@uiw/react-json-view": "^2.0.0-alpha.39",
    "geist": "^1.5.1",
    "lucide-react": "^1.28.0",
    "mammoth": "^1.11.0",
    "next": "^16.3.0",
    "pdf-parse": "^1.1.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.2",
    "@types/jsdom": "^28.0.3",
    "@types/node": "^22.10.2",
    "@types/pdf-parse": "^1.1.5",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.17.0",
    "eslint-config-next": "^16.3.0",
    "jsdom": "^29.1.1",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.23.7",
    "typescript": "^5.7.2"
  }
}
